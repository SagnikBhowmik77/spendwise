# Copy to server/.env (never commit .env).

PORT=8730
# Browser origins allowed to call the API, comma-separated (add the Vercel URL in step 10).
CLIENT_ORIGIN=http://localhost:5200
# Set to 1 on Render (one proxy in front of the app).
TRUST_PROXY=0

# Step 1: MongoDB Atlas connection string
# MONGODB_URI=

# Step 2: generated locally, long random string
# JWT_SECRET=

# Step 8: SMTP for monthly reports
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=

# Optional: DNS servers for the mongodb+srv lookup when Node cannot resolve it locally.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Optional: time zone for "today" in recurring entries (default Asia/Kolkata).
# APP_TIMEZONE=Asia/Kolkata
# Optional sender shown in emails (default: Spendwise <SMTP_USER>)
# SMTP_FROM=
# Web app address used for links in emails (step 10: your Vercel URL)
# APP_URL=http://localhost:5200

# Browser push notifications (batch 12D). Generate a pair with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# A contact for push services (mailto: or https:). Default: mailto:<SMTP_USER>
# VAPID_SUBJECT=

# Google Sheets sync (optional): an OAuth "Web application" client; add <API_URL>/api/integrations/google/callback
# as a redirect URI in Google Cloud.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Telegram bot (optional): token from @BotFather. With TELEGRAM_WEBHOOK_URL (the API's public address) the bot runs by
# webhook; without it the server polls. Only one of them can hold the bot at a time.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_URL=
# TELEGRAM_POLLING=false

# Production email relay (optional): where SMTP is blocked (Render's free tier), set these and the API posts mail to
# client/api/send-mail.js on Vercel instead. Same MAIL_RELAY_SECRET on both sides; leave unset to use SMTP directly.
# MAIL_RELAY_URL=https://<your-vercel-app>/api/send-mail
# MAIL_RELAY_SECRET=
