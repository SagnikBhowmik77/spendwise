# Copy to client/.env.production for a production build (step 10: set it in Vercel instead).
# Leave empty in development: Vite forwards /api to http://localhost:8730.
# VITE_API_URL=https://your-api.onrender.com

# The address the web app is served from (step 10: the Vercel URL). Used for link-preview tags in index.html.
# VITE_SITE_URL=https://spendwise.example.vercel.app
# Optional: shown on the privacy and terms pages as the address for questions.
# VITE_CONTACT_EMAIL=
